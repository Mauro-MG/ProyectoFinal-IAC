# Configuración de las pruebas de carga contra un despliegue de AbastoRed en Google Cloud.
# Copia este archivo como tests/carga/gcp/config.env y pon los valores de TU entorno.
# No lleva secretos: solo nombres de recursos, la URL pública y la ruta al certificado PÚBLICO del gateway.

# Recursos de Compute Engine (gcloud debe tener sesión con una cuenta que pueda usar SSH por IAP)
GCP_PROYECTO=<tu-proyecto>
GCP_ZONA=<tu-zona>            # p. ej. us-central1-c
GCP_VM=<nombre-de-tu-vm>

# Entrada pública (gateway NGINX) y su certificado público, para verificar TLS sin desactivarlo
ABASTO_HOST=https://<ip-o-dominio-de-tu-vm>
ABASTO_CA=apps/infra/gcp/certificado_gateway_gcp.crt

# Python con locust==2.32.2 instalado (pip install locust==2.32.2 requests)
LOCUST_PY=python

# Cuentas de prueba por corrida (una por usuario virtual; deben alcanzar para MAX_USUARIOS)
COMERCIANTES=90
ANALISTAS=30
AUDITORES=15

# Límites y condiciones de parada (ver README.md)
MAX_USUARIOS=150          # concurrencia máxima permitida en cualquier etapa
DURACION_MAX_S=2400       # tope de cada corrida (el muestreo de la VM también se detiene aquí)
UMBRAL_ERRORES=0.05       # 5xx + timeouts + conexión sobre el total, sostenido 30 s
UMBRAL_P95_MS=3000        # p95 de respuestas EXITOSAS sostenido 60 s
MEM_MIN_MB=1500           # memoria disponible mínima en la VM
DISCO_MIN_GB=5            # disco libre mínimo en la VM
TIMEOUT_S=30              # timeout de cada petición
