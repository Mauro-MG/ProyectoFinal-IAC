# Configuración de AbastoRed (sin secretos).
# Las contraseñas y llaves NO van aquí: «python scripts/preparar_entorno.py» las genera
# en secrets/ y Docker las monta en /run/secrets sólo en los contenedores que las usan.

# desarrollo | produccion  (en produccion el arranque falla si falta un secreto o es de ejemplo)
ENTORNO=desarrollo
FLASK_ENV=development
# Cookies de sesión sólo por HTTPS (el gateway sirve HTTPS)
COOKIES_SEGURAS=true
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# PostgreSQL (contraseña en secrets/postgres_password.txt)
POSTGRES_HOST=abastored-postgres
POSTGRES_PORT=5432
POSTGRES_DB=abastored
POSTGRES_USER=abastored_admin

# MongoDB (contraseña en secrets/mongo_password.txt)
MONGO_HOST=abastored-mongo
MONGO_PORT=27017
MONGO_DB=abastored
MONGO_USER=abastored_admin

# Redis (contraseña en secrets/redis_password.txt)
REDIS_HOST=abastored-redis
REDIS_PORT=6379
PRECIO_PROMEDIO_TTL_SEGUNDOS=14400

# Google Cloud Storage (avance 4)
GCS_BUCKET_NAME=abastored-bucket-placeholder

# Microservicios: las direcciones internas (http://ms-<servicio>:8000) salen de
# libs/abasto_dominio/abasto_dominio/registro_servicios.py; aquí sólo se cambia alguna si hace falta,
# p. ej. MS_PEDIDOS_URL=http://localhost:8106 para correr el web fuera de Docker.
