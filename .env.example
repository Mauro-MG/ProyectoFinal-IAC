# Flask configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=super-secret-key-change-in-production
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production

# PostgreSQL configuration
POSTGRES_HOST=abastored-postgres
POSTGRES_PORT=5432
POSTGRES_DB=abastored
POSTGRES_USER=abastored_admin
POSTGRES_PASSWORD=postgres_password_example

# MongoDB configuration
MONGO_HOST=abastored-mongo
MONGO_PORT=27017
MONGO_DB=abastored
MONGO_USER=abastored_admin
MONGO_PASSWORD=mongo_password_example

# Redis configuration
REDIS_HOST=abastored-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_example
PRECIO_PROMEDIO_TTL_SEGUNDOS=14400

# Google Cloud Storage
GCS_BUCKET_NAME=abastored-bucket-placeholder
