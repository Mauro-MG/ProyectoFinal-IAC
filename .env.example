# Flask configuration
FLASK_ENV=development
SECRET_KEY=super-secret-key-change-in-production
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# PostgreSQL configuration
POSTGRES_HOST=abastored-postgres
POSTGRES_PORT=5432
POSTGRES_DB=abastored
POSTGRES_USER=abastored_admin
POSTGRES_PASSWORD=postgres_password_example

# MongoDB configuration
MONGO_HOST=abastored-mongo
MONGO_PORT=27017
MONGO_DB=abastored
MONGO_USER=abastored_admin
MONGO_PASSWORD=mongo_password_example

# Redis configuration
REDIS_HOST=abastored-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_example
PRECIO_PROMEDIO_TTL_SEGUNDOS=14400

# Google Cloud Storage
GCS_BUCKET_NAME=abastored-bucket-placeholder

# Microservicios (direcciones dentro de la red de Docker)
MS_SEGURIDAD_URL=http://ms-seguridad:8000
MS_COMERCIOS_URL=http://ms-comercios:8000
MS_CATALOGO_URL=http://ms-catalogo:8000
MS_INVENTARIO_URL=http://ms-inventario:8000
MS_PRECIOS_URL=http://ms-precios:8000
MS_PEDIDOS_URL=http://ms-pedidos:8000
MS_ANALISIS_URL=http://ms-analisis:8000
MS_NOTIFICACIONES_URL=http://ms-notificaciones:8000
MS_TIMEOUT_SEGUNDOS=3
# Peticiones por minuto por usuario (o IP) en cada servicio
RATE_LIMIT_POR_MINUTO=120
# Tamaño máximo de archivos subidos (MB)
MAX_ARCHIVO_MB=10
